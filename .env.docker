# Docker Compose evaluation environment only.
# Do not use this file as a production secret/configuration source.

APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8000
NGINX_PORT=8000
NGINX_SSL_PORT=8443
FRONTEND_PORT=3000

# Database password (must match what's in backend/.env.docker)
DB_PASSWORD=postgres

# Email is configured in backend/.env; production requires authenticated SMTP.

# Supabase Storage — optional, local file storage used by default
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_URL=
