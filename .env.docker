# Docker Compose Environment
# Copy this to .env before running docker-compose up

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
NGINX_PORT=8000
NGINX_SSL_PORT=8443
FRONTEND_PORT=3000

# Database password (must match what's in backend/.env.docker)
DB_PASSWORD=postgres

# Resend (Email) — optional, mail defaults to log in dev
RESEND_API_KEY=

# Supabase Storage — optional, local file storage used by default
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_URL=
