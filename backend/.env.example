APP_NAME=ChurchManager
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://churchmanager.app
FRONTEND_URL=https://churchmanager.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_PREVIOUS_KEYS=  ← Comma-separated for key rotation (format: base64:xxx,base64:yyy)

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ──────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=church_management
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# DATABASE_URL=  ← Only for Supabase pooler (session mode): postgresql://<user>:<pass>@<host>:6543/postgres?sslmode=require
# DB_HOST=db.<project>.pooler.supabase.com  ← Transaction pooler for serverless/queue
# DB_PORT=6543  ← Supabase pooler port
# DB_USERNAME=postgres.<project>  ← Supabase pooler user format

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Use 'file' for basic setups, 'redis' for production (requires REDIS_HOST + REDIS_PASSWORD)
CACHE_STORE=file

# ──────────────────────────────────────────────
# Mail / Resend
# ──────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@churchmanager.app"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# ──────────────────────────────────────────────
# Supabase Storage (Native REST API)
# SUPABASE_URL — Your Supabase project URL (https://<project>.supabase.co)
# SUPABASE_ANON_KEY — Public anon key (safe for client-side use)
# SUPABASE_SERVICE_ROLE_KEY — Secret service_role key (backend only, NEVER expose to client)
# SUPABASE_STORAGE_URL — Custom CDN URL (optional, for Supabase Storage CDN)
# Leave SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY empty to fall back to local filesystem
# ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_URL=
SUPABASE_MAX_IMAGE_SIZE=5120
SUPABASE_MAX_DOCUMENT_SIZE=10240

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Frontend API URL (for production / Vite builds)
# ──────────────────────────────────────────────
VITE_API_URL=https://api.churchmanager.app

# ──────────────────────────────────────────────
# Sanctum — comma-separated list of frontend domains for SPA authentication
# ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=churchmanager.app,api.churchmanager.app
SANCTUM_TOKEN_PREFIX=ch_
SANCTUM_TOKEN_EXPIRATION=1440

# ──────────────────────────────────────────────
# CORS — comma-separated origins for API access
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://churchmanager.app
CORS_MAX_AGE=86400

# ──────────────────────────────────────────────
# Trusted Proxies — IPs behind the reverse proxy
# Use '*' to trust all proxies (common in Docker/K8s)
# ──────────────────────────────────────────────
TRUSTED_PROXIES=*

# ──────────────────────────────────────────────
# Database — additional connection options
# ──────────────────────────────────────────────
DB_EMULATE_PREPARES=false

# ──────────────────────────────────────────────
# Session — inactivity timeout in minutes
# ──────────────────────────────────────────────
SESSION_INACTIVITY_TIMEOUT=60

# ──────────────────────────────────────────────
# Platform Admin
# ──────────────────────────────────────────────
PLATFORM_ADMIN_LOGIN_PATH=platform-secure-admin-login

# ──────────────────────────────────────────────
# Support Contact
# ──────────────────────────────────────────────
SUPPORT_PHONE=+201234567890
SUPPORT_EMAIL=support@churchmanager.app
