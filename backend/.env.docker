APP_NAME=ChurchManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=church_management
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file

# ──────────────────────────────────────────────
# Mail / Resend Configuration
# ──────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@churchmanager.app"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# ──────────────────────────────────────────────
# Supabase Storage (Native REST API)
# ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_URL=
SUPABASE_MAX_IMAGE_SIZE=5120
SUPABASE_MAX_DOCUMENT_SIZE=10240

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Sanctum Stateful Domains
# ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,localhost:8000
SANCTUM_TOKEN_PREFIX=ch_dev_

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE=86400

# ──────────────────────────────────────────────
# Trusted Proxies
# ──────────────────────────────────────────────
TRUSTED_PROXIES=*

# ──────────────────────────────────────────────
# Platform Admin
# ──────────────────────────────────────────────
PLATFORM_ADMIN_LOGIN_PATH=platform-secure-admin-login

# ──────────────────────────────────────────────
# Support Contact
# ──────────────────────────────────────────────
SUPPORT_PHONE=+201234567890
SUPPORT_EMAIL=support@churchmanager.app
