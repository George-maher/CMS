<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
        Security testsuite: the tenant-isolation and authorization gate.

        This is a NAMED, EXPLICIT list rather than a directory glob. It exists
        so the PostgreSQL CI job can run a focused, high-signal security gate
        on the real production engine without paying for the whole feature
        suite, and so that adding a new security test is a deliberate act
        (adding a line here) rather than something that happens by accident
        when a file is created in tests/Feature.

        The driver-independence of every test listed here is enforced by
        running this same suite on BOTH SQLite and PostgreSQL in CI.
        -->
        <testsuite name="Security">
            <file>tests/Feature/CompositeForeignKeyTest.php</file>
            <file>tests/Feature/AttendanceConcurrencyTest.php</file>
            <file>tests/Feature/AttendanceClassIdSpaceTest.php</file>
            <file>tests/Feature/CreateUserStageOwnershipTest.php</file>
            <file>tests/Feature/TenantArchitectureTest.php</file>
            <file>tests/Feature/TenantConsistencyTest.php</file>
            <file>tests/Feature/TenantHierarchyIntegrityTest.php</file>
            <file>tests/Feature/TenantIsolationMatrixTest.php</file>
            <file>tests/Feature/TenantOrphanRepairTest.php</file>
            <file>tests/Feature/TenantOwnershipBoundaryTest.php</file>
            <file>tests/Feature/TenantScopeHeaderIsolationTest.php</file>
            <file>tests/Feature/PlatformAdminAuthorizationMatrixTest.php</file>
            <file>tests/Feature/ChurchScopeLoginTest.php</file>
            <file>tests/Feature/StageAdminScopeTest.php</file>
            <file>tests/Feature/StageClassBulkTest.php</file>
            <file>tests/Feature/QRInviteCrossChurchScopingTest.php</file>
            <file>tests/Feature/QRInviteTest.php</file>
            <file>tests/Feature/ChurchApplicationAccessTest.php</file>
            <file>tests/Feature/ChurchDeletionTest.php</file>
            <file>tests/Feature/StorageEndpointAuthorizationTest.php</file>
            <file>tests/Feature/EmailVerificationTokenSecurityTest.php</file>
            <file>tests/Feature/InviteRegistrationFlowTest.php</file>
            <file>tests/Feature/ServantLoginLifecycleTest.php</file>
            <file>tests/Feature/MembershipRequestSubmitTest.php</file>
            <file>tests/Feature/PasswordResetRequestTest.php</file>
            <file>tests/Feature/PasswordHashTest.php</file>
            <file>tests/Feature/RequestIdTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_KEY" value="base64:4v7Xs9zKv2d4mNp3qRt6uWxY8bEnMcLgO5jHk1Ao0sQ="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
