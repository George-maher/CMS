# ──────────────────────────────────────────────
# Frontend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env

# Backend API URL.
# ⚠️ The client.ts code ALWAYS appends /api/v1, regardless of whether
#    VITE_API_URL already contains /api or not. So:
#
#   VITE_API_URL=https://railway-app.up.railway.app
#     → final baseURL: https://railway-app.up.railway.app/api/v1  ✅
#
#   VITE_API_URL=https://railway-app.up.railway.app/api
#     → final baseURL: https://railway-app.up.railway.app/api/v1  ✅ (path overwritten)
#
#   VITE_API_URL=http://localhost:8000
#     → final baseURL: http://localhost:8000/api/v1  ✅
#
#   VITE_API_URL=/api  (Docker dev — Vite proxies /api to nginx)
#     → final baseURL: /api/v1  ✅
#
# In Docker dev, leave as /api (Vite dev server proxies /api → nginx).
# For production (Vercel + Railway), set to the Railway backend root URL
# WITHOUT trailing slash, WITHOUT /api prefix:
#   VITE_API_URL=https://your-railway-app.up.railway.app
VITE_API_URL=/api

# Platform admin login path — must match backend's PLATFORM_ADMIN_LOGIN_PATH
VITE_PLATFORM_ADMIN_LOGIN_PATH=platform-secure-admin-login

# Backend proxy target (development only) — Vite dev server forwards /api here
VITE_API_PROXY=http://nginx

# PWA — disable service worker registration in dev if needed
# VITE_DISABLE_SW=false
