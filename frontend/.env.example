# ──────────────────────────────────────────────
# Frontend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env

# Backend API URL. In Docker dev, Vite proxies /api to nginx.
# For standalone frontend dev (npm run dev outside Docker), set to:
#   VITE_API_URL=http://localhost:8000/api
# For production (Vercel), set to your backend's public URL:
#   VITE_API_URL=https://your-api.com
VITE_API_URL=/api

# Platform admin login path — must match backend's PLATFORM_ADMIN_LOGIN_PATH
VITE_PLATFORM_ADMIN_LOGIN_PATH=platform-secure-admin-login

# Backend proxy target (development only) — Vite dev server forwards /api here
VITE_API_PROXY=http://nginx
